.DS_Store
.env

# make version が生成するcommitHash付きバージョン（コミットしない）
/version.full

backend/.gocache/
backend/.gomodcache/

frontend/.npm-cache/
frontend/dist/
frontend/node_modules/
frontend/tsconfig.tsbuildinfo

# ffmpeg.wasm のコア（vite.config.ts が node_modules から複製・再生成。31MBのwasmは追跡しない）
frontend/public/ffmpeg/

# Playwright（.agents/tools）実行時にcwd次第で生成されることがある成果物
test-results/

backups/

# nginx アクセスログ（ホストへバインドマウント、logrotateで保全。コミットしない）
logs/

# design-sync (claude.ai/design) の生成物・機械状態
.ds-sync/
ds-bundle/
.design-sync/.cache/

.agents/
.claude/skills/deploy

/action.sh
