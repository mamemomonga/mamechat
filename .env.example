# =============================================================================
# mamechat 環境変数サンプル
# =============================================================================
# 使い方:
#   cp .env.example .env
#
# 値に空白を含める場合でも、Docker Compose の .env として読むため基本的に
# クォートせずそのまま書きます。URL末尾の "/" はアプリ側で取り除かれます。


# -----------------------------------------------------------------------------
# アプリ基本設定
# -----------------------------------------------------------------------------

# 実行環境名。development では Cookie の secure 既定値が false、それ以外では true になります。
APP_ENV=development

# 画面やメタ情報に表示するサービス名です。
SERVICE_NAME=mamechat

# Go バックエンドが listen するアドレスです。Compose 内では :8080 のままで使います。
HTTP_ADDR=:8080

# アプリのバージョンを環境変数で明示したい場合に使います。
# 未設定なら version.full、なければ version ファイルから読みます。
APP_VERSION=


# -----------------------------------------------------------------------------
# データストア
# -----------------------------------------------------------------------------

# PostgreSQL 接続URLです。Compose 起動時は postgres サービス名を使います。
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable

# Valkey/Redis 接続URLです。チャット配信、プレゼンス、キャッシュ、TTSキューで使います。
REDIS_URL=redis://valkey:6379/0


# -----------------------------------------------------------------------------
# セッション / CORS
# -----------------------------------------------------------------------------

# ログインセッション Cookie の名前です。
SESSION_COOKIE_NAME=app_session

# セッションの有効期限（時間）です。2160時間は約90日です。
SESSION_TTL_HOURS=2160

# true にすると HTTPS 上でのみ Cookie を送ります。本番HTTPS運用では true 推奨です。
# 開発時の http://localhost では false にしてください。
SESSION_COOKIE_SECURE=false

# フロントエンドの Origin です。CORS と WebSocket upgrade の Origin 検証に使います。
CORS_ALLOWED_ORIGIN=http://localhost:5173

# チャット本文の最大文字数です。0以下は既定値の400に補正されます。
MESSAGE_MAX_LENGTH=400


# -----------------------------------------------------------------------------
# 在室 / アクティブ状態
# -----------------------------------------------------------------------------

# チャンネル一覧が在室/アクティブ状態を反映するために、RESTで一覧データを
# 再取得する間隔（秒）です。チャンネル内のチャットはWebSocketで更新されます。
# 5〜300秒の範囲に自動補正されます。
ACTIVE_POLL_SECONDS=15

# チャンネル接続中のクライアントが「閲覧中」をサーバへ申告する間隔（秒）です。
# 5〜60秒の範囲に自動補正されます。
BEACON_SECONDS=10

# 最後のビーコンから何秒までアクティブ扱いするかを決める有効期間です。
# BEACON_SECONDS の3倍以上に自動補正されます（最大300秒）。
ACTIVE_WINDOW_SECONDS=30


# -----------------------------------------------------------------------------
# 初期オーナーユーザー
# -----------------------------------------------------------------------------

# オーナーログイン用パスワードです。Compose 起動時は必須です。
OWNER_PASSWORD=

# 初期オーナーユーザーの表示名です。
OWNER_DISPLAY_NAME=Owner

# 初期オーナーユーザーのハンドル名です。
OWNER_HANDLE=owner.local

# 初期オーナーユーザーのアバターURLです。空なら未設定です。
OWNER_AVATAR_URL=


# -----------------------------------------------------------------------------
# SNSログイン / OAuth
# -----------------------------------------------------------------------------

# AT Protocol OAuth の公開ベースURLです。外部から到達できるバックエンドURLを指定します。
ATPROTO_PUBLIC_BASE_URL=http://localhost:8080

# AT Protocol の認証サーバURLの既定値です。ログイン時は利用者のDID→PDS→認可サーバを
# 自動解決するため、独自PDSでもこの値に依存しません（後方互換のため残しています）。
ATPROTO_AUTH_SERVER_URL=https://bsky.social

# Bluesky公開APIのURLです。ハンドル→DIDのフォールバック解決やプロフィール取得に使います。
ATPROTO_PUBLIC_API_URL=https://public.api.bsky.app

# did:plc のDIDドキュメントを解決するPLCディレクトリです。独自PDSのログインで
# DID→PDS→認可サーバを辿るために使います。通常は既定のままで使います。
ATPROTO_PLC_DIRECTORY_URL=https://plc.directory

# AT Protocol OAuth で要求する scope です。
ATPROTO_OAUTH_SCOPE=atproto transition:generic

# AT Protocol ログイン後に戻すフロントエンドURLです。
ATPROTO_LOGIN_REDIRECT_URL=http://localhost:5173

# Mastodon OAuth ログイン後に戻すフロントエンドURLです。
MASTODON_LOGIN_REDIRECT_URL=http://localhost:5173

# Misskey MiAuth ログイン後に戻すフロントエンドURLです。
MISSKEY_LOGIN_REDIRECT_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# チャンネル運用
# -----------------------------------------------------------------------------

# 準備中になったチャンネルを自動削除候補として保持する期間（時間）です。
CHANNEL_SUSPEND_RETENTION_HOURS=24

# オーナー離席からチャンネルを準備中へ移行するまでの猶予（分）です。
# 0 は無期限（離席しても自動では準備中にしない）です。
CHANNEL_SUSPEND_GRACE_MINUTES=0


# -----------------------------------------------------------------------------
# アップロード
# -----------------------------------------------------------------------------

# 添付画像・動画の保存ディレクトリです。Compose では永続volumeへ割り当てます。
UPLOAD_STORAGE_DIR=/storage/uploads

# 静止画像アップロードの最大サイズ（バイト）です。
UPLOAD_MAX_BYTES=5242880

# GIF/APNG/音声なしMP4など、チャット添付メディアの最大サイズ（バイト）です。
UPLOAD_MEDIA_MAX_BYTES=20971520

# MP4添付の最大長さ（秒）です。
UPLOAD_VIDEO_MAX_SECONDS=30

# アップロード後、投稿に使われなかった一時ファイルを保持する時間（分）です。
UPLOAD_STAGING_TTL_MINUTES=60


# -----------------------------------------------------------------------------
# TTS / VOICEVOX
# -----------------------------------------------------------------------------

# TTS機能全体の有効/無効です。true/1/yes が true 扱いです。
TTS_ENABLED=true

# 生成済みTTS音声ファイルの保存ディレクトリです。
TTS_STORAGE_DIR=/storage/tts

# VOICEVOX ENGINE のURLです。複数指定する場合はカンマ区切りです。
TTS_VOICEVOX_URLS=http://voicevox:50021,http://voicevox-2:50021

# TTSキャッシュ識別に含めるVOICEVOX ENGINEのバージョン文字列です。
TTS_VOICEVOX_ENGINE_VERSION=voicevox-unknown

# 1チャンネルあたり同時に待機できるTTSジョブ数の上限です。
TTS_MAX_PENDING_PER_CHANNEL=5

# TTS worker の並列数です。0以下は1に補正されます。
TTS_WORKER_CONCURRENCY=2

# 未使用TTS音声ファイルのGC実行間隔（分）です。
TTS_GC_INTERVAL_MINUTES=60


# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------
# 未設定ならPush通知機能は無効です。
# 鍵の生成:
#   make vapid-keygen
#   または docker compose run --rm backend /bin/vapid-keygen

# VAPID公開鍵です。ブラウザへ配布されます。
VAPID_PUBLIC_KEY=

# VAPID秘密鍵です。外部へ公開しないでください。
VAPID_PRIVATE_KEY=

# VAPID subject です。管理者連絡先として mailto: または URL を指定します。
VAPID_SUBJECT=mailto:admin@example.com


# -----------------------------------------------------------------------------
# フロントエンド（Vite）
# -----------------------------------------------------------------------------

# ブラウザから見たAPIベースURLです。空なら同一オリジンを使います。
VITE_API_BASE_URL=http://localhost:8080

# ブラウザから見たWebSocketベースURLです。空なら現在のホストから自動生成します。
VITE_WS_BASE_URL=ws://localhost:8080

# 開発用モックモードです。通常は空のままにします。
# 例: 1 / owner / admin
VITE_MOCK_USER=


# -----------------------------------------------------------------------------
# 本番Compose / nginx
# -----------------------------------------------------------------------------

# 本番用 nginx をホストに公開するポートです。
PROD_HTTP_PORT=8080

# 本番用 nginx 経由でブラウザから見えるOriginです。
PROD_CORS_ALLOWED_ORIGIN=http://localhost:8080

# 本番用 nginx のアクセスログ保存先です。ホスト側 logrotate と組み合わせます。
NGINX_LOG_DIR=./logs/nginx
